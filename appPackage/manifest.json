    "privacyUrl": "https://powell78jarvisbbm.eu.ngrok.io/privacy",
    "termsOfUseUrl": "https://powell78jarvisbbm.eu.ngrok.io/terms"
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "name": {
    "short": "Jarvis",
    "full": "Jarvis - AI Meeting Assistant"
  },
  "description": {
    "short": "AI-powered assistant for Microsoft Teams meetings with speech recognition",
