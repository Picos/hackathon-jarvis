        "team",
        "groupchat"
      ],
      "supportsFiles": false,
      "isNotificationOnly": false,
      "supportsCalling": true,
      "supportsVideo": true
    }
  ],
  "permissions": [
    "identity",
    "messageTeamMembers"
  ],
  "validDomains": [
    "powell78jarvisbbm.eu.ngrok.io"
  ],
  "webApplicationInfo": {
    "id": "47fc3eac-34c0-472f-a685-acb565d0c7b3",
    "resource": "https://graph.microsoft.com"
  },
  "defaultInstallScope": "team",
  "defaultGroupCapability": {
    "team": "tab",
    "groupchat": "bot",
    "meetings": "bot"
  }
