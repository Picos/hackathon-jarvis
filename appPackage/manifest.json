{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "47fc3eac-34c0-472f-a685-acb565d0c7b3",
  "packageName": "com.teamsassistbot.jarvis",
  "developer": {
    "name": "Teams Assist Bot",
